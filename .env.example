# PostgreSQL
POSTGRES_USER=freelance
POSTGRES_PASSWORD=changeme
POSTGRES_DB=freelance_analyser
DATABASE_URL=postgresql+psycopg://freelance:changeme@db:5432/freelance_analyser

# IMAP E-Mail-Zugang
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD=changeme

# Freelancermap
FREELANCERMAP_COOKIE_BROWSER=firefox
# Alternativ: Login-Daten (Fallback wenn Cookie abgelaufen)
FREELANCERMAP_USER=
FREELANCERMAP_PASSWORD=

# Logging
LOG_LEVEL=INFO
