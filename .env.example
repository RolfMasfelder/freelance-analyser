# PostgreSQL — auch für docker-compose (Container-Init)
POSTGRES_USER=freelance
POSTGRES_PASSWORD=
POSTGRES_DB=freelance_analyser
DATABASE_URL=postgresql+psycopg://freelance:<pg_password>@db:5432/freelance_analyser

# IMAP E-Mail-Zugang
IMAP_HOST=imap.ionos.de
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# IMAP_SSL=true  # Standard: true

# Freelancermap
FREELANCERMAP_COOKIE_BROWSER=firefox
# Alternativ: Login-Daten (Fallback wenn Cookie abgelaufen)
FREELANCERMAP_USER=
FREELANCERMAP_PASSWORD=

# CV-Datei
CV_PATH=data/cv.yaml

# LLM (LM Studio auf zweitem Rechner)
LLM_BASE_URL=http://192.1.2.3:1234/v1
LLM_API_KEY=lm-studio
# LLM_MODEL=zai-org/glm-4.7-flash
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=2400

# Logging
LOG_LEVEL=DEBUG
# LOG_LEVEL=INFO  # Standard: INFO
