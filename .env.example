# PostgreSQL — auch für docker-compose (Container-Init)
POSTGRES_USER=freelance
POSTGRES_PASSWORD=
POSTGRES_DB=freelance_analyser
DATABASE_URL=postgresql+psycopg://freelance:<password>@db:5432/freelance_analyser

# IMAP E-Mail-Zugang
IMAP_HOST=imap.ionos.de
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# IMAP_SSL=true  # Standard: true

# Freelancermap
# FREELANCERMAP_COOKIE_BROWSER=firefox  # Standard: firefox
FREELANCERMAP_USER=
FREELANCERMAP_PASSWORD=

# Logging
# LOG_LEVEL=INFO  # Standard: INFO
